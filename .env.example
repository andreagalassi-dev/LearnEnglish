# ========================================================
# LinguaNet AI - Configurazione Variabili d'Ambiente
# ========================================================

# Chiave API Google Gemini (da Google AI Studio: https://aistudio.google.com/)
# Se lasciata vuota o non valida, l'applicazione utilizzerà la modalità Tutor locale dimostrativa
VITE_GOOGLE_GEMINI_API_KEY=AIzaSy...

# Modello Google Gemini preferito (opzionale)
# Modelli veloci supportati: gemini-3.8-flash (predefinito), gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash-lite, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Porta del Server Express (Predefinita: 3001)
PORT=3001

# Chiave segreta per la firma dei Token JWT (Autenticazione)
JWT_SECRET=super-secret-jwt-key-change-in-production

# URL base per le chiamate API dal frontend (opzionale, predefinito: /api tramite proxy Vite)
# VITE_API_URL=/api

